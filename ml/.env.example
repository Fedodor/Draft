# Copy this file to ml/.env. Never commit ml/.env.
#
# STRATZ_API_KEY is required by STRATZ collectors.
# OPENDOTA_API_KEY is optional; without it OpenDota uses lower rate limits.
STRATZ_API_KEY=replace-with-stratz-token
OPENDOTA_API_KEY=

# Optional HTTP settings for collectors.
ML_HTTP_TIMEOUT_SECONDS=30
ML_MAX_RETRIES=3
ML_LOG_LEVEL=INFO
