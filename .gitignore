!ml/datasets/heroes.json
ml/cache/
ml/logs/
ml/training/output/
ml/experiments/

# Generated model artifacts; only the bundled release model is tracked.
ml/models/*
!ml/models/draft_model_xgboost_full.onnx
!ml/models/draft_model_xgboost_full_config.json
!ml/models/draft_model_xgboost_full_features.json
!ml/models/draft_model_xgboost_full_schema.json

